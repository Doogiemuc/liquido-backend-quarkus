pom.xml.versionsBackup
release.properties
.flattened-pom.xml

# Eclipse
.project
.classpath
.settings/
bin/

# IntelliJ
# Ignore .idea, but share the few files that set the project up for new contributors:
# externalDependencies.xml -> IDEA offers to install/enable the Lombok plugin on first open
# compiler.xml             -> keeps annotation processing enabled (Lombok needs it)
.idea/*
!.idea/externalDependencies.xml
!.idea/compiler.xml
*.ipr
*.iml
*.iws

# NetBeans
nb-configuration.xml

# Visual Studio Code
.vscode
.factorypath

# OSX
.DS_Store

# Vim
*.swp
*.swo

# patch
*.orig
*.rej

# Local environment
application.local
.env

# Exclude secrets !!!
*.pem
*.p12
# JWT signing keys must never be committed. liquidoJwtKey.json was tracked in a public
# repo until 2026-07-30; the JWT secret now lives in config/application-<profile>.properties.
liquidoJwtKey.json
src/main/resources/*key*.json

# Exclude configurations with secrets
application-prod.yml
/config/application-test.properties
/config/application-local.properties
/config/application-prod.properties
/config/application-dev.properties
/config/application-*.properties
/backup/fly.io.bak/application-fly-int.properties
/import-testData.sql
/createLiquidoDbSchema.sql
/LiquidoExceptionCodes.js
/liquido-testData.sql
